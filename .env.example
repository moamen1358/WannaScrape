# =============================================================================
# Web Scraper Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Environment variables take precedence over config.json settings.

# -----------------------------------------------------------------------------
# API Server Settings
# -----------------------------------------------------------------------------
SCRAPER_API_HOST=0.0.0.0
SCRAPER_API_PORT=8000
SCRAPER_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Browser Settings
# -----------------------------------------------------------------------------
# Run browser in headless mode (true/false)
SCRAPER_HEADLESS=true

# Browser action delay in milliseconds (for human-like behavior)
SCRAPER_SLOW_MO=50

# Browser timeout in milliseconds
SCRAPER_BROWSER_TIMEOUT=30000

# -----------------------------------------------------------------------------
# CAPTCHA Solving (Optional)
# -----------------------------------------------------------------------------
# Enable CAPTCHA solving (requires API key)
SCRAPER_CAPTCHA_ENABLED=false

# CAPTCHA service: 2captcha or capsolver
SCRAPER_CAPTCHA_SERVICE=2captcha

# API key for CAPTCHA solving service
SCRAPER_CAPTCHA_API_KEY=

# CAPTCHA solving timeout in seconds
SCRAPER_CAPTCHA_TIMEOUT=120

# -----------------------------------------------------------------------------
# Proxy Settings (Optional)
# -----------------------------------------------------------------------------
# Enable proxy rotation
SCRAPER_PROXY_ENABLED=false

# Path to proxy file (format: host:port:user:pass per line)
SCRAPER_PROXY_FILE=config/proxies.txt

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum requests per domain per hour
SCRAPER_MAX_REQUESTS_PER_HOUR=60

# Minimum delay between requests (seconds)
SCRAPER_MIN_DELAY=2

# Maximum delay between requests (seconds)
SCRAPER_MAX_DELAY=8

# -----------------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------------
# Maximum time for a single scrape operation (seconds)
SCRAPER_MAX_SCRAPE_TIMEOUT=120

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
SCRAPER_LOG_LEVEL=DEBUG

# Log directory
SCRAPER_LOG_DIR=data/logs

# -----------------------------------------------------------------------------
# Data Directories
# -----------------------------------------------------------------------------
SCRAPER_SCREENSHOTS_DIR=data/screenshots
SCRAPER_SESSIONS_DIR=data/sessions
